#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB    &kp K  &kp Y     &kp U      &kp COMMA  &kp MINUS    &kp V      &kp M  &kp H      &kp P    &kp J      &kp EQUAL
&kp LCTRL  &kp D  &kp I     &kp E      &kp A      &kp O        &kp C      &kp S  &kp N      &kp T    &kp R      &kp W
&kp GRAVE  &kp X  &kp FSLH  &kp DOT    &kp QMARK  &kp SEMI     &kp F      &kp G  &kp L      &kp B    &kp Q      &kp RSHFT
                           &kp LALT    &mo 1      &kp RET      &kp SPACE  &mo 2  &kp LSHFT
            >;
        };

        symbols_layer {
            bindings = <
&kp TAB    &kp EXCL   &kp FSLH  &kp LT     &kp GT     &kp PLUS     &kp LBKT   &kp LBKT  &kp RBKT  &kp TILDE  &kp GRAVE  &kp BSLH
&kp PRCNT  &kp CARET  &kp DQT   &kp PIPE   &kp DLLR   &kp AMPS     &kp HASH   &kp LPAR  &kp RPAR   &kp SEMI   &kp SQT   &kp GRAVE
&kp LSHFT  &kp SQT    &kp SQT   &kp DOT    &kp QMARK  &kp SEMI     &kp AT     &kp LBRC  &kp RBRC   &kp COLON  &kp DOT   &kp RSHFT
                                &kp LALT   &trans     &kp RET      &kp SPACE  &mo 2     &kp LSHFT
            >;
        };

        num_layer {
            bindings = <
&kp TAB    &kp LCTRL  &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT    &kp BSPC   &kp UP    &kp H      &kp P      &kp RCTRL  &kp Z
&kp CAPS   &kp N6     &kp N3    &kp N1    &kp N2     &kp N7       &kp N9     &kp N4    &kp N0     &kp N5     &kp N8     &kp R
&kp LSHFT  &kp COMMA  &kp FSLH  &kp SQT   &kp DOT    &kp F        &kp SEMI   &kp G     &kp L      &kp B      &kp DOT    &kp RSHFT
                                &kp LALT   &mo 1      &kp RET      &kp SPACE  &trans    &kp LSHFT
            >;
        };
    };
};
